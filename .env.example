MODEL_API_KEY=
ASR_MODEL=muse-voice-transcribe-1.0
FRONTEND_ORIGIN=http://localhost:5173
# Ajuste de latencia de las llamadas a Muse Spark: on (por defecto) = reasoning_effort="low"
# y max_tokens acotado, con un único reintento sin ajuste si falla. off = parámetros por
# defecto de la API, como antes del ajuste (sin reasoning_effort ni max_tokens).
LATENCY_TUNING=on
